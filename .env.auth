NODE_ENV=development
PORT=3011
LOG_LEVEL=info
APP_NAME=service-boilerplate
TRUST_PROXY=1
API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
STRICT_RATE_LIMIT_MAX=20
MONGODB_URI="mongodb://127.0.0.1:27017/service_boilerplate"
AUTH_SERVICE_URL=http://localhost:3011
SCHEDULER_ENABLED=false
SCHEDULER_CRON=*/30 * * * *
SCHEDULER_TIMEZONE=Africa/Nairobi
