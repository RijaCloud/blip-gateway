NODE_ENV=development
PORT=3010
LOG_LEVEL=info
APP_NAME=service-boilerplate
TRUST_PROXY=1
API_KEY=change-me
AUTH_SERVICE_URL=http://localhost:3010
CHAT_SERVICE_URL=http://localhost:3010
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
